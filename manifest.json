{
  "manifest_version": 3,
  "name": "Clip Live",
  "version": "1.4.0",
  "description": "Replay buffer de lives do YouTube, Twitch e Kick: salva um clipe de 30s ou 1min num clique e corta sozinho quando o chat ri.",
  "minimum_chrome_version": "120",
  "permissions": [
    "alarms",
    "downloads",
    "scripting",
    "storage"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.youtube.com/*",
        "https://www.twitch.tv/*",
        "https://kick.com/*"
      ],
      "js": [
        "lib/mediabunny.min.js",
        "mux.js",
        "content.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://www.twitch.tv/*"
      ],
      "js": [
        "twitch-quality.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://www.youtube.com/*"
      ],
      "js": [
        "youtube-quality.js"
      ],
      "run_at": "document_idle",
      "world": "MAIN"
    }
  ],
  "action": {
    "default_title": "Clip Live",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "commands": {
    "clip-60": {
      "suggested_key": {
        "default": "Alt+Shift+2"
      },
      "description": "Clipar o último 1min"
    },
    "clip-90": {
      "suggested_key": {
        "default": "Alt+Shift+3"
      },
      "description": "Clipar o último 1min30"
    }
  },
  "host_permissions": [
    "https://www.youtube.com/*",
    "https://www.twitch.tv/*",
    "https://kick.com/*",
    "http://127.0.0.1/*"
  ]
}
